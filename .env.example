# Runtime settings. Copy to .env.local for local work; never commit real keys.
APP_URL=http://127.0.0.1:4317
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_AUTH_ENABLED=false
APPLE_AUTH_ENABLED=false
# 0 = free tier does not expire. Set before launch; applied to NEW accounts only.
FREE_TRIAL_DAYS=0
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Local-only account mode. Keep false on deployed environments.
LOCAL_AUTH_ENABLED=false
# Optional local data directory (default: data)
LOCAL_DATA_DIR=
# Stripe Pro price must be USD 299 cents, recurring monthly.

# Pro: USD 299 cents/month and USD 3000 cents/year.
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
